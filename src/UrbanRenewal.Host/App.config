<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- 允许托管代码捕获 AccessViolationException（ArcObjects/NA 原生层偶发损坏态） -->
    <legacyCorruptedStateExceptionsPolicy enabled="true" />
  </runtime>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
</configuration>
