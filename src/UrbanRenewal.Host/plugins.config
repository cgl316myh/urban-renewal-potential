  <plugin id="Validation" assembly="UrbanRenewal.Plugins.Validation.dll" enabled="true" order="50" />
  <plugin id="Output" assembly="UrbanRenewal.Plugins.Output.dll" enabled="true" order="60" />
  <plugin id="Config" assembly="UrbanRenewal.Plugins.Config.dll" enabled="true" order="70" />
</plugins>
