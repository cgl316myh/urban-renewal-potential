  <!-- 用 MSBuild 复制插件，避免 PostBuild 批命令在中文路径下退出 9009 -->
  <Target Name="CopyPluginsToHost" AfterTargets="Build">
    <PropertyGroup>
      <_PluginsOut>$(TargetDir)Plugins</_PluginsOut>
      <_SrcRoot>$(MSBuildProjectDirectory)\..</_SrcRoot>
    </PropertyGroup>
    <MakeDir Directories="$(_PluginsOut)" />
    <ItemGroup>
      <_PluginDll Include="$(_SrcRoot)\UrbanRenewal.Plugins.DataManage\bin\$(Configuration)\UrbanRenewal.Plugins.DataManage.dll" Condition="Exists('$(_SrcRoot)\UrbanRenewal.Plugins.DataManage\bin\$(Configuration)\UrbanRenewal.Plugins.DataManage.dll')" />
      <_PluginDll Include="$(_SrcRoot)\UrbanRenewal.Plugins.Motivation\bin\$(Configuration)\UrbanRenewal.Plugins.Motivation.dll" Condition="Exists('$(_SrcRoot)\UrbanRenewal.Plugins.Motivation\bin\$(Configuration)\UrbanRenewal.Plugins.Motivation.dll')" />
      <_PluginDll Include="$(_SrcRoot)\UrbanRenewal.Plugins.Feasibility\bin\$(Configuration)\UrbanRenewal.Plugins.Feasibility.dll" Condition="Exists('$(_SrcRoot)\UrbanRenewal.Plugins.Feasibility\bin\$(Configuration)\UrbanRenewal.Plugins.Feasibility.dll')" />
      <_PluginDll Include="$(_SrcRoot)\UrbanRenewal.Plugins.Overlay\bin\$(Configuration)\UrbanRenewal.Plugins.Overlay.dll" Condition="Exists('$(_SrcRoot)\UrbanRenewal.Plugins.Overlay\bin\$(Configuration)\UrbanRenewal.Plugins.Overlay.dll')" />
      <_PluginDll Include="$(_SrcRoot)\UrbanRenewal.Plugins.Validation\bin\$(Configuration)\UrbanRenewal.Plugins.Validation.dll" Condition="Exists('$(_SrcRoot)\UrbanRenewal.Plugins.Validation\bin\$(Configuration)\UrbanRenewal.Plugins.Validation.dll')" />
      <_PluginDll Include="$(_SrcRoot)\UrbanRenewal.Plugins.Output\bin\$(Configuration)\UrbanRenewal.Plugins.Output.dll" Condition="Exists('$(_SrcRoot)\UrbanRenewal.Plugins.Output\bin\$(Configuration)\UrbanRenewal.Plugins.Output.dll')" />
      <_PluginDll Include="$(_SrcRoot)\UrbanRenewal.Plugins.Config\bin\$(Configuration)\UrbanRenewal.Plugins.Config.dll" Condition="Exists('$(_SrcRoot)\UrbanRenewal.Plugins.Config\bin\$(Configuration)\UrbanRenewal.Plugins.Config.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginDll)" DestinationFolder="$(_PluginsOut)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Delete Files="$(_PluginsOut)\UrbanRenewal.Contracts.dll;$(_PluginsOut)\UrbanRenewal.Model.dll;$(_PluginsOut)\UrbanRenewal.GIS.dll;$(_PluginsOut)\UrbanRenewal.Analysis.dll;$(_PluginsOut)\UrbanRenewal.PluginLoader.dll;$(_PluginsOut)\UrbanRenewal.Core.dll" ContinueOnError="true" />
  </Target>
